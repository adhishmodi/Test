# Development-only settings. Never put real credentials in this file.
APP_ENV=development
LOG_LEVEL=INFO

# Inside the Codespaces Compose network, use service names (postgres, redis).
DATABASE_URL=postgresql+asyncpg://traffic_app:dev_only_change_me@postgres:5432/traffic_monitor
REDIS_URL=redis://redis:6379/0
RQ_QUEUE_NAME=traffic

# Local temporary files only; do not commit uploaded media or generated artifacts.
UPLOAD_DIR=./var/uploads
